# Desenvolvimento local: sem DATABASE_URL, usa imovelfacil.db (SQLite).
# Produção: configure obrigatoriamente um PostgreSQL persistente.
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/imovefacil

# Segredo longo e aleatório usado para assinar os tokens Bearer.
# Obrigatório trocar o valor em produção.
JWT_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_SECONDS=86400
